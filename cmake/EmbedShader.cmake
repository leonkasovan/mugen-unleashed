# Turns shader bytes into a C string without CMake list/continuation parsing.
# Usage: cmake -DIN=<file> -DOUT=<header> -DNAME=<variable> -P EmbedShader.cmake
if(NOT NAME MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
  message(FATAL_ERROR "Invalid C variable: ${NAME}")
endif()
file(READ "${IN}" _source)
string(REPLACE "\r" "" _source "${_source}")
# Match the portable Make generator's final newline for nonempty input.
if(NOT _source STREQUAL "" AND NOT _source MATCHES "\n$")
  string(APPEND _source "\n")
endif()
string(REPLACE "\\" "\\\\" _source "${_source}")
string(REPLACE "\"" "\\\"" _source "${_source}")
string(REPLACE "\n" "\\n\"\n    \"" _source "${_source}")
file(WRITE "${OUT}" "/* Generated by cmake/EmbedShader.cmake. */\nstatic const char ${NAME}[] =\n    \"${_source}\";\n")
