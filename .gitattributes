# Keep the repository itself LF: every shell script, C source and doc here is
# written with LF and the build tools (bash, make, gcc) do not care. Windows
# batch files are the exception -- cmd.exe wants CRLF, and a script full of
# goto labels is exactly where an LF-only file can misbehave on older Windows.
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Shell scripts must stay LF in every checkout: sh rejects a CRLF shebang line
# and `set -eu` fails with "Illegal option -" when the file carries CR.
*.sh    text eol=lf

# Lua helpers are committed as text and embedded by the build.
*.lua   text eol=lf

# Binary artefacts that must never be line-ending converted.
*.png   binary
*.ico   binary
*.7z    binary
*.zip   binary
*.exe   binary
*.dll   binary
*.a     binary
*.sff   binary
*.snd   binary
