# Port additions: section-aware config patching and native output validation.
# Iterate over strings, not CMake lists: INI comments contain semicolons.
include_guard(GLOBAL)

function(_mugen_vita_take_line input line rest)
  string(FIND "${input}" "\n" _end)
  if(_end LESS 0)
    set(${line} "${input}" PARENT_SCOPE)
    set(${rest} "" PARENT_SCOPE)
  else()
    string(SUBSTRING "${input}" 0 ${_end} _line)
    math(EXPR _next "${_end}+1")
    string(SUBSTRING "${input}" ${_next} -1 _rest)
    set(${line} "${_line}" PARENT_SCOPE)
    set(${rest} "${_rest}" PARENT_SCOPE)
  endif()
endfunction()

function(mugen_vita_ini_set variable section key value)
  string(REPLACE "\r\n" "\n" _rest "${${variable}}")
  string(TOLOWER "${section}" _wanted_section)
  string(TOLOWER "${key}" _wanted_key)
  set(_output "")
  set(_current "")
  set(_written FALSE)
  while(NOT _rest STREQUAL "")
    _mugen_vita_take_line("${_rest}" _line _rest)
    if(_line MATCHES "^[ \t]*\\[([^]]+)\\]")
      if(_current STREQUAL _wanted_section AND NOT _written)
        string(APPEND _output "${key} = ${value}\n")
        set(_written TRUE)
      endif()
      string(STRIP "${CMAKE_MATCH_1}" _current)
      string(TOLOWER "${_current}" _current)
    elseif(_current STREQUAL _wanted_section AND
           _line MATCHES "^[ \t]*([^=;]+)=")
      string(STRIP "${CMAKE_MATCH_1}" _candidate)
      string(TOLOWER "${_candidate}" _candidate)
      if(_candidate STREQUAL _wanted_key)
        if(NOT _written)
          string(APPEND _output "${key} = ${value}\n")
          set(_written TRUE)
        endif()
        continue() # Remove duplicate active keys in the target group only.
      endif()
    endif()
    string(APPEND _output "${_line}\n")
  endwhile()
  if(NOT _written)
    if(NOT _current STREQUAL _wanted_section)
      string(APPEND _output "\n[${section}]\n")
    endif()
    string(APPEND _output "${key} = ${value}\n")
  endif()
  set(${variable} "${_output}" PARENT_SCOPE)
endfunction()

function(mugen_vita_ini_get text section key result)
  string(REPLACE "\r\n" "\n" _rest "${text}")
  string(TOLOWER "${section}" _wanted_section)
  string(TOLOWER "${key}" _wanted_key)
  set(_current "")
  set(${result} "" PARENT_SCOPE)
  while(NOT _rest STREQUAL "")
    _mugen_vita_take_line("${_rest}" _line _rest)
    if(_line MATCHES "^[ \t]*\\[([^]]+)\\]")
      string(STRIP "${CMAKE_MATCH_1}" _current)
      string(TOLOWER "${_current}" _current)
    elseif(_current STREQUAL _wanted_section AND
           _line MATCHES "^[ \t]*([^=;]+)=(.*)$")
      set(_value "${CMAKE_MATCH_2}")
      string(STRIP "${CMAKE_MATCH_1}" _candidate)
      string(TOLOWER "${_candidate}" _candidate)
      if(_candidate STREQUAL _wanted_key)
        string(REGEX REPLACE ";.*$" "" _value "${_value}")
        string(STRIP "${_value}" _value)
        set(${result} "${_value}" PARENT_SCOPE)
        return()
      endif()
    endif()
  endwhile()
endfunction()

function(mugen_vita_require_ini text section key expected)
  mugen_vita_ini_get("${text}" "${section}" "${key}" _actual)
  if(NOT _actual STREQUAL "${expected}")
    message(FATAL_ERROR "mugen.cfg patch did not apply: [${section}] ${key}: expected '${expected}', got '${_actual}'")
  endif()
endfunction()

function(mugen_vita_validate_resolution renderer game_width game_height width height)
  foreach(_dimension game_width game_height width height)
    if(NOT "${${_dimension}}" MATCHES "^[1-9][0-9]*$" OR ${_dimension} GREATER 4096)
      message(FATAL_ERROR "Invalid Vita ${_dimension}: ${${_dimension}} (expected 1..4096)")
    endif()
  endforeach()
  string(TOLOWER "${renderer}" _renderer)
  if(_renderer STREQUAL "openglscreen" AND
     (NOT game_width STREQUAL width OR NOT game_height STREQUAL height))
    message(FATAL_ERROR "OpenGLScreen uses the game size as its display size; choose matching game/output resolutions or use OpenGL for independent sizes.")
  endif()
  if(_renderer STREQUAL "opengl" OR _renderer STREQUAL "openglscreen")
    set(_modes 960x544 720x408 640x368 480x272)
    if(NOT "${width}x${height}" IN_LIST _modes)
      message(FATAL_ERROR "Unsupported Vita OpenGL output ${width}x${height}; use 960x544, 720x408, 640x368 or 480x272. Set the game resolution separately for other internal sizes.")
    endif()
  endif()
endfunction()

function(mugen_vita_patch_config variable)
  set(_cfg "${${variable}}")
  mugen_vita_ini_set(_cfg Config GameWidth "${MUGEN_VITA_VIDEO_WIDTH}")
  mugen_vita_ini_set(_cfg Config GameHeight "${MUGEN_VITA_VIDEO_HEIGHT}")
  mugen_vita_ini_set(_cfg Config FirstRun 0)
  mugen_vita_ini_set(_cfg Video Width "${MUGEN_VITA_OUTPUT_WIDTH}")
  mugen_vita_ini_set(_cfg Video Height "${MUGEN_VITA_OUTPUT_HEIGHT}")
  if(MUGEN_VITA_FULLSCREEN)
    set(_fullscreen 1)
  else()
    set(_fullscreen 0)
  endif()
  mugen_vita_ini_set(_cfg Video FullScreen "${_fullscreen}")
  if(NOT MUGEN_VITA_RENDERMODE STREQUAL "")
    mugen_vita_ini_set(_cfg Video RenderMode "${MUGEN_VITA_RENDERMODE}")
  endif()
  mugen_vita_ini_set(_cfg Misc Precache "${MUGEN_VITA_PRECACHE}")
  mugen_vita_ini_set(_cfg Debug ShowFPS 1)

  # Validate values in their actual groups, independently of spelling/spacing.
  mugen_vita_require_ini("${_cfg}" Config GameWidth "${MUGEN_VITA_VIDEO_WIDTH}")
  mugen_vita_require_ini("${_cfg}" Config GameHeight "${MUGEN_VITA_VIDEO_HEIGHT}")
  mugen_vita_require_ini("${_cfg}" Config FirstRun 0)
  mugen_vita_require_ini("${_cfg}" Video Width "${MUGEN_VITA_OUTPUT_WIDTH}")
  mugen_vita_require_ini("${_cfg}" Video Height "${MUGEN_VITA_OUTPUT_HEIGHT}")
  mugen_vita_require_ini("${_cfg}" Video FullScreen "${_fullscreen}")
  mugen_vita_require_ini("${_cfg}" Debug ShowFPS 1)
  mugen_vita_require_ini("${_cfg}" Misc Precache "${MUGEN_VITA_PRECACHE}")
  mugen_vita_ini_get("${_cfg}" Video RenderMode _renderer)
  mugen_vita_validate_resolution("${_renderer}" "${MUGEN_VITA_VIDEO_WIDTH}"
    "${MUGEN_VITA_VIDEO_HEIGHT}" "${MUGEN_VITA_OUTPUT_WIDTH}" "${MUGEN_VITA_OUTPUT_HEIGHT}")
  set(${variable} "${_cfg}" PARENT_SCOPE)
endfunction()
