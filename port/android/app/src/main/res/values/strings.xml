<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">mugen-unleashed</string>
    <!-- Key under which the chosen game folder is remembered (SharedPreferences). -->
    <string name="game_folder_key" translatable="false">game_folder</string>
    <!-- Label of the overlay button that lets the player pick the game tree. -->
    <string name="game_folder_str">Select Game Folder</string>
    <!-- Shown after the folder is saved: the working directory is resolved once,
         before the engine starts, so the change needs a fresh launch. -->
    <string name="game_folder_saved">Folder saved. Quit and reopen M.U.G.E.N to use it.</string>
    <!-- Shown while the engine reloads itself into the newly chosen folder. -->
    <string name="game_folder_switching">Switching game folder\u2026</string>
</resources>
