<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon (Android 8+).

    Both layers come from res/icons/*.ico via tools/make_android_icons.sh, the
    same artwork the Windows and PS Vita builds use:
      - @color/ic_launcher_background   a flat colour (values/colors.xml)
      - @mipmap/ic_launcher_foreground  the artwork, drawn on a transparent
        108dp canvas with the picture confined to the 72dp safe zone, so a round
        or squircle mask never crops it.

    The per-density bitmap wraps the icon for everything below API 26.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
