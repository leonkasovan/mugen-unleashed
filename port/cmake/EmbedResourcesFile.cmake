# Embed every resource in INPUT_DIR as C data.
#
#   cmake -DINPUT_DIR=<dir> -DOUTPUT=<header> -DPREFIX=<prefix> \
#         -DMODE=<string|hex> -DEXT=<ext> [-DLAST=<name>] \
#         -P EmbedResourcesFile.cmake
#
# MODE=string writes one C string literal per file (res/configs); MODE=hex
# writes byte arrays plus an EmbeddedFile table (res/lua). Line endings are
# normalised to LF so this and the GNU Make generator (tools/embed_resources.sh)
# embed the same bytes on every host.
if(NOT DEFINED INPUT_DIR OR NOT DEFINED OUTPUT OR NOT DEFINED PREFIX OR
   NOT DEFINED MODE OR NOT DEFINED EXT)
  message(FATAL_ERROR "INPUT_DIR, OUTPUT, PREFIX, MODE and EXT are required")
endif()
if(NOT MODE STREQUAL "string" AND NOT MODE STREQUAL "hex")
  message(FATAL_ERROR "MODE must be string or hex")
endif()

file(GLOB _files "${INPUT_DIR}/*.${EXT}")
list(SORT _files)
if(DEFINED LAST AND NOT LAST STREQUAL "")
  list(FIND _files "${INPUT_DIR}/${LAST}" _last_index)
  if(NOT _last_index EQUAL -1)
    list(REMOVE_AT _files ${_last_index})
    list(APPEND _files "${INPUT_DIR}/${LAST}")
  endif()
endif()
if(NOT _files)
  message(FATAL_ERROR "no .${EXT} files in ${INPUT_DIR}")
endif()

get_filename_component(_directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${_directory}")
file(WRITE "${OUTPUT}.tmp" "/* Generated by port/cmake/EmbedResourcesFile.cmake. Do not edit. */\n")

set(_table "")
foreach(_file IN LISTS _files)
  get_filename_component(_name "${_file}" NAME)
  string(MAKE_C_IDENTIFIER "g_${PREFIX}_${_name}" _variable)
  if(MODE STREQUAL "string")
    file(READ "${_file}" _text)
    if(_text STREQUAL "")
      message(FATAL_ERROR "empty resource: ${_file}")
    endif()
    string(REPLACE "\r\n" "\n" _text "${_text}")
    string(REPLACE "\r" "\n" _text "${_text}")
    if(NOT _text MATCHES "\n$")
      string(APPEND _text "\n")
    endif()
    string(REPLACE "\\" "\\\\" _text "${_text}")
    string(REPLACE "\"" "\\\"" _text "${_text}")
    string(REPLACE "\n" "\\n\"\n    \"" _text "${_text}")
    file(APPEND "${OUTPUT}.tmp" "static const char ${_variable}[] =\n    \"${_text}\";\n")
  else()
    # Read the bytes one per line, then strip CR at BYTE level. Doing this on
    # file(READ ... HEX) is wrong: the hex dump is one flat string, so
    # string(REPLACE "0d" "") deletes the 0d of any byte that merely ends in 0d
    # (0xd0, 0x0d, 0x2d, ...) and corrupts the payload. That is what dropped
    # 0xd0 from every UTF-8 Cyrillic character -- "-- " (2d 2d 20 d0 9f) came
    # out as 2d 2d 20 9f. The Make generator (tools/embed_resources.sh) emits
    # the file with od and never touches the values, so the two disagreed.
    file(READ "${_file}" _bytes HEX)
    if(_bytes STREQUAL "")
      message(FATAL_ERROR "empty resource: ${_file}")
    endif()
    string(REGEX REPLACE "(..)" "\\1\n" _bytes "${_bytes}")
    string(REGEX REPLACE "0d\n" "" _bytes "${_bytes}")
    string(REGEX REPLACE "(..)\n" "0x\\1," _bytes "${_bytes}")
    file(APPEND "${OUTPUT}.tmp" "static const unsigned char ${_variable}[] = {${_bytes}};\n")
    string(APPEND _table "    { \"${_name}\", ${_variable}, sizeof(${_variable}) },\n")
  endif()
endforeach()

if(MODE STREQUAL "hex")
  file(APPEND "${OUTPUT}.tmp" "#ifndef MUGEN_EMBEDDED_FILE_DEFINED\n#define MUGEN_EMBEDDED_FILE_DEFINED\ntypedef struct EmbeddedFile {\n    const char *name;\n    const unsigned char *data;\n    unsigned int size;\n} EmbeddedFile;\n#endif\n\n")
  file(APPEND "${OUTPUT}.tmp" "static const EmbeddedFile g_${PREFIX}_files[] = {\n${_table}};\n")
endif()

execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different
                        "${OUTPUT}.tmp" "${OUTPUT}"
                RESULT_VARIABLE _result)
if(NOT _result EQUAL 0)
  message(FATAL_ERROR "Cannot write embedded resource header ${OUTPUT}")
endif()
file(REMOVE "${OUTPUT}.tmp")
