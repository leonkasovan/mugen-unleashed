# Embed every res/configs/*.cfg as a C byte array.
#
#   cmake -DINPUT_DIR=<res/configs> -DOUTPUT=<config_data.h> -P EmbedConfigsFile.cmake
#
# The generated header defines g_config_<flattened-name> for every file, the
# same names tools/embed_configs.sh produces for the GNU Make build. Hex bytes
# avoid CMake list splitting; bytes are normalised to LF so the GNU Make
# generator (tools/embed_configs.sh) embeds the same content.
file(GLOB _config_files "${INPUT_DIR}/*.cfg")
list(SORT _config_files)
if(NOT _config_files)
  message(FATAL_ERROR "no .cfg files in ${INPUT_DIR}")
endif()

get_filename_component(_directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${_directory}")
file(WRITE "${OUTPUT}.tmp" "/* Generated by port/cmake/EmbedConfigsFile.cmake. Do not edit. */\n")
foreach(_file IN LISTS _config_files)
  get_filename_component(_name "${_file}" NAME)
  string(MAKE_C_IDENTIFIER "g_config_${_name}" _variable)
  file(READ "${_file}" _bytes HEX)
  string(REPLACE "0d0a" "0a" _bytes "${_bytes}")
  string(REGEX REPLACE "(..)" "0x\\1," _bytes "${_bytes}")
  file(APPEND "${OUTPUT}.tmp" "static const char ${_variable}[] = {${_bytes}0};\n")
endforeach()

execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different
                        "${OUTPUT}.tmp" "${OUTPUT}"
                RESULT_VARIABLE _result)
if(NOT _result EQUAL 0)
  message(FATAL_ERROR "Cannot write embedded configuration header ${OUTPUT}")
endif()
file(REMOVE "${OUTPUT}.tmp")
